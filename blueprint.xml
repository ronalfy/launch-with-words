<div class="gb-element-0063a389 alignfull"><!-- wp:generateblocks/element {"uniqueId":"1afada83","tagName":"div","styles":{"maxWidth":"900px","marginLeft":"auto","marginRight":"auto"},"css":".gb-element-1afada83{margin-left:auto;margin-right:auto;max-width:900px}"} -->
<div class="gb-element-1afada83"><!-- wp:heading -->
<h2 class="wp-block-heading">Wouldn't it be awesome to launch a website for your small business client with a year's worth of blog post prompts?</h2>
<!-- /wp:heading -->

<!-- wp:generateblocks/text {"uniqueId":"fb0db873","tagName":"p"} -->
<p class="gb-text">This free WordPress plugin helps your small business create content. This content marketing strategy is based on Bridget Willard's ebook, “<strong>If You </strong>Don't<strong> Mind Your Business, Who Will?</strong>“</p>
<!-- /wp:generateblocks/text -->

<!-- wp:generateblocks/text {"uniqueId":"af1ad59f","tagName":"h2","styles":{"paddingBottom":"0px","marginBottom":"0px"},"css":".gb-text-af1ad59f{margin-bottom:0px;padding-bottom:0px}"} -->
<h2 class="gb-text gb-text-af1ad59f">What is Launch With Words?<br></h2>
<!-- /wp:generateblocks/text -->

<!-- wp:generateblocks/text {"uniqueId":"5cd91e10","tagName":"p","styles":{"marginBottom":"1px","marginTop":"0px","paddingTop":"0px"},"css":".gb-text-5cd91e10{margin-bottom:1px;margin-top:0px;padding-top:0px}"} -->
<p class="gb-text gb-text-5cd91e10">Launch With Words is a new WordPress plugin that combines a small-business writer's experience with <strong>blogging prompts</strong> to encourage you to publish once a month. <em>Easy!</em><br></p>
<!-- /wp:generateblocks/text --></div>
<!-- /wp:generateblocks/element --></div>
<!-- /wp:generateblocks/element -->

<!-- wp:generateblocks/element {"uniqueId":"acad1193","tagName":"div"} -->
<div><!-- wp:generateblocks/text {"uniqueId":"96de97ad","tagName":"p"} -->
<p class="gb-text">Thank you for reading. Be sure to <a href="https://launchwithwords.com/shop/">grab a content pack</a> to start your journey.</p>
<!-- /wp:generateblocks/text -->

